#!/usr/bin/env bash
# asr-stream — start/stop/status the FFmpeg → YouTube stream process.
#
# Installed to /usr/local/bin/asr-stream by asr_server/install-server.sh.
set -euo pipefail

CONF="${ASR_CONF:-/etc/autosim/stream.conf}"
PIDFILE="${ASR_STREAM_PID:-$HOME/.asr/asr-stream.pid}"
LOG="${ASR_STREAM_LOG:-$HOME/.asr/asr-stream.log}"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_SCRIPT="${ASR_STREAM_RUN:-$BIN_DIR/asr-stream-run}"
LOG_HELPER="${ASR_STREAM_LOG_HELPER:-$BIN_DIR/asr-stream-log}"
ENVFILE="${ASR_ENV:-/etc/autosim/stream.env}"

is_running() {
  [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

cmd="${1:-status}"
case "$cmd" in
  start)
    if is_running; then
      echo "asr-stream already running (pid $(cat "$PIDFILE"))."
      exit 0
    fi

    # Guard: refuse to start a second encoder on the SAME ingest URL we are about
    # to use. This prevents the duplicate-encoder failure seen when the CLI and
    # the (also installable) asr-stream.service both ran at once — two ffmpeg
    # processes on one key desyncs the stream and trips YouTube's "not receiving
    # enough video" buffering. It checks only the active URL (INGEST in
    # stream.conf), so the intentional primary+backup redundancy from
    # asr-stream-ingest (encoders on *different* URLs) is still allowed.
    if [[ -r "$ENVFILE" ]]; then
      set -a
      # shellcheck disable=SC1090
      source "$ENVFILE"
      set +a
    fi
    local_ingest=primary
    if [[ -r "$CONF" ]]; then
      local_ingest="$(sed -nE 's/^INGEST=(.*)$/\1/p' "$CONF" | tr -d '[:space:]')"
      local_ingest="${local_ingest:-primary}"
    fi
    target_url=""
    if [[ "$local_ingest" == "backup" ]]; then
      target_url="${RTMP_BACKUP_URL:-}"
    else
      target_url="${RTMP_URL:-}"
    fi
    if [[ -n "$target_url" && -n "${STREAM_KEY:-}" ]]; then
      if pgrep -ax ffmpeg | grep -Fq "${target_url}/${STREAM_KEY}"; then
        echo "error: another ffmpeg is already pushing to ${target_url}/${STREAM_KEY}." >&2
        echo "  Refusing to start a duplicate encoder on the same ingest URL." >&2
        echo "  If it is stale, clean it up with:  sudo pkill -x ffmpeg" >&2
        exit 1
      fi
    fi

    if [[ ! -x "$RUN_SCRIPT" ]]; then
      echo "error: $RUN_SCRIPT not found/executable." >&2
      exit 1
    fi
    if [[ ! -x "$LOG_HELPER" ]]; then
      echo "error: $LOG_HELPER not found/executable." >&2
      exit 1
    fi

    # Determine the active SOURCE.
    local_source=test
    if [[ -r "$CONF" ]]; then
      local_source="$(sed -nE 's/^SOURCE=(.*)$/\1/p' "$CONF" | tr -d '[:space:]')"
      local_source="${local_source:-test}"
    fi

    if [[ "$local_source" == "tracksim" ]]; then
      # The renderer must be feeding the FIFO, or FFmpeg blocks with no frames
      # and YouTube reports "no encoder input". Ensure it is running.
      # asr-track start now waits for the renderer to stabilise and fails
      # loudly (with the log tail) if it exits during boot.
      if ! "$BIN_DIR/asr-track" status >/dev/null 2>&1; then
        echo "track_sim renderer not running for SOURCE=tracksim; starting it..."
        "$BIN_DIR/asr-track" start
      fi
      if ! "$BIN_DIR/asr-track" status >/dev/null 2>&1; then
        echo "error: track_sim renderer failed to start. Check ~/track_sim/logs/stream.log" >&2
        exit 1
      fi
    fi

    mkdir -p "$(dirname "$LOG")" "$(dirname "$PIDFILE")"
    # Run the stream under a supervised logger: it prefaces every line with a
    # timestamp and trims the log to the 100 most-recent entries. The pidfile
    # records THIS logger's pid; on stop it forwards the signal to ffmpeg.
    nohup "$LOG_HELPER" "$RUN_SCRIPT" "$LOG" >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    echo "Started asr-stream (pid $(cat "$PIDFILE")). Log: $LOG"
    ;;
  stop)
    if is_running; then
      kill "$(cat "$PIDFILE")"
      rm -f "$PIDFILE"
      echo "Stopped asr-stream."
    else
      echo "asr-stream not running."
    fi
    ;;
  status)
    if is_running; then
      echo "asr-stream running (pid $(cat "$PIDFILE"))."
    else
      echo "asr-stream stopped."
    fi
    ;;
  *)
    echo "usage: asr-stream {start|stop|status}" >&2
    exit 1
    ;;
esac
